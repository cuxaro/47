				<script type="text/javascript">
					function initSecciones() {
						var secciones = [];
						$("[class*='seccion-']").each(function () {
							var className = this.className.match(/seccion-?\d+/);
							if (className) {
								secciones.push(className[0]);
								//$("." + className[0]).first().show(); // Se puede hacer asi directamente. sin usar el array, pero intuyo que de esta forma se ejecuta mas veces de las necesarias 
							}
						});
						secciones = jQuery.unique( secciones );
						$(secciones).each(function () {
							$("." + this).hide();
							$("." + this).first().show();
							initEntidades(this);
						});
					}

					function initEntidades(seccionName) {
						var seccionNumber = seccionName.replace('seccion-', '');
						var entidades = [];
						$("[class*='entidad-" + seccionNumber + "-']").each(function () {
							var className = this.className.match(/entidad-\d+--?\d+/);
							if (className) {
							entidades.push(className[0]);
								//$("." + className[0]).first().show(); // Se puede hacer asi directamente. sin usar el array, pero intuyo que de esta forma se ejecuta mas veces de las necesarias 
						}
						});
						entidades = jQuery.unique( entidades );
						$(entidades).each(function () {
							$("." + this).hide();
							$("." + this).first().show();
						});
					}

					initSecciones();

					function seccionToggle(id) {
						var seccion = $(id).first();
						if (seccion.find(".fa-caret-up").is(':visible')) {
							seccion.find(".fa-caret-up").hide();
							seccion.find(".fa-caret-down").show();
							$(id).next().hide(); // Ocultamos los paneles de entidad
							$(id).next().next().hide(); // Ocultamos los paneles de anuncio
							$(id).parent().parent().hide(); // Ocultamos los paneles del datagrid
							$(id).first().parent().parent().show(); // Mostramos el primer panel del datagrid
							//$(id).parent().parent().slice(1).hide(); // Ocultamos los paneles del datagrid (a partir del primero)
						} else {
							seccion.find(".fa-caret-up").show();
							seccion.find(".fa-caret-down").hide();
							$(id).next().show(); // Mostramos los paneles de entidad
							$(id).next().next().show(); // Mostramos los paneles de anuncio
							$(id).parent().parent().show(); // Mostramos los paneles del datagrid
							initEntidades(id.substr(1)); // Inicializamos los paneles de entidad (el substr es para eliminar el '.' del id de seccion)
						}
					}

					function anuncioRelacionadoToggle(id) {
						if ($('.anuncio-' + id).is(':visible')) {
							$('.minus-' + id).hide();
							$('.plus-' + id).show();
							$('.anuncio-' + id).slideUp();
						} else {
							$('.minus-' + id).show();
							$('.plus-' + id).hide();
							$('.anuncio-' + id).slideDown();
						}
					}

					//var startTime;
					//var stopTime;

					function onStartFilter() {
						//startTime = new Date();
						//console.log("Inicio busqueda: " + startTime);

						startStatusSearch();
						var datatable = PF('list');
						if (datatable != undefined) {
							datatable.getPaginator().setPage(0);
						}

						// Ajustes en los campos de fechas
						datePickerClearMask('filtroCalendarioIni');
						datePickerClearMask('filtroCalendarioFin');
					}

					function onCompleteFilter() {
						stopStatus();
						// Marcamos el texto buscado en el contenido del anuncio
						var regexp = new RegExp('"[^"]+"', 'g');
						var str = $('#buscador').val();
						$.each(str.match(regexp), function( index, value ) {
							value = value.substr(1, value.length - 2); // Quitamos las comillas
							//console.log("marcar palabras exactas: " + value);
							$('.anuncio .contenido').mark(value, { "separateWordSearch": false, "accuracy": { "value": "exactly", "limiters": ".,:;'\"(){}".split("") }, "wildcards": "enabled", "exclude": [".info .negrita"] } );
						});
						str = str.replace(regexp, '');
						//console.log("quitamos las busquedas exactas: " + str);

						/*
						// Exclusiones. Como estas palabras no se utilizan en la busqueda, tampoco tenemos que marcarlas
						var exclude = [
								//"a", "ante", "bajo", "cabe", "con", "contra", "de", "desde", "en", "entre", "hacia", "hasta", "para", "por", "según", "sin", "so", "sobre", "tras", "durante", "mediante", "versus", "vía",
								"a", "al", "als", "con", "amb", "de", "del", "dels", "d'", "en", "para", "por", "per",
								"el", "la", "los", "las", "els", "les", "l'",
								"un", "una", "unos", "unas", "uns", "unes", "n'",
								"y", "i"];
						str = str.split(' ').filter(function(value, index, arr) {
							return exclude.indexOf(value) < 0;
						}).join(' ');
						*/

						//console.log("marcar palabras separadas: " + str);
						$('.anuncio .contenido').mark(str, { "separateWordSearch": true, "accuracy": { "value": "exactly", "limiters": ".,:;'\"(){}".split("") }, "wildcards": "enabled", "exclude": [".info .negrita"] } );

						//console.log("marcar numero registro: " + $('#numeroRegistro\\:field').val());
						$('.anuncio .contenido .info').mark($('#numeroRegistro\\:field').val(), { "separateWordSearch": true, "accuracy": { "value": "exactly", "limiters": ".,:;'\"(){}".split("") }, "wildcards": "enabled", "exclude": [".info .negrita"] } );

						// Inicializamos las secciones
						initSecciones();

						// Inicializamos los botones de compartir en redes sociales
						initSocial();

						//stopTime = new Date();
						//console.log("Fin busqueda: " + stopTime);
						//console.log("Tiempo busqueda: " + msToHMS(stopTime - startTime));
						//console.log("Registro totales: " + PF('list').cfg.paginator.rowCount);
					}

					function onResetFilter() {
						// Inicializamos las secciones
						initSecciones();

						// Inicializamos los botones de compartir en redes sociales
						initSocial();

						// Restauramos el datePicker porque de lo contrario no se muestra correctamente el calendario (si hemos cambiado de mes) 
						//restoreDatePicker('filtroCalendarioIni');
						//restoreDatePicker('filtroCalendarioFin');
						restoreDatePicker('calen');
					}
